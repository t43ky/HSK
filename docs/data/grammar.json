":["nǐ","shì","bu","shì","lǎoshī",""],"k":"당신은 선생님인가요?"}],"q":[{"z":["你","去","不","去","？"],"p":["nǐ","qù","bu","qù",""],"k":"너 갈 거야 안 갈 거야?","b":2,"o":["不","没","吗"]}]},{"id":19,"lv":1,"t":"시간·장소의 순서","f":"주어 + 시간 + 장소 + 동사","d":"중국어는 시간과 장소를 동사 앞에 둡니다. 시간이 장소보다 먼저 옵니다.","ex":[{"z":["我","明天","去","学校","。"],"p":["wǒ","míngtiān","qù","xuéxiào",""],"k":"나는 내일 학교에 간다."},{"z":["他","每","天","早上","六","点","起床","。"],"p":["tā","měi","tiān","zǎoshang","liù","diǎn","qǐchuáng",""],"k":"그는 매일 아침 6시에 일어난다."}],"q":[{"z":["我","明天","在","家","休息","。"],"p":["wǒ","míngtiān","zài","jiā","xiūxi",""],"k":"나는 내일 집에서 쉰다.","b":1,"o":["明天","在","去"]}]},{"id":20,"lv":2,"t":"过: 경험","f":"동사 + 过","d":"‘~한 적이 있다’. 부정은 没(有) + 동사 + 过.","ex":[{"z":["这","条","路","我","走","过","很","多","次","。"],"p":["zhè","tiáo","lù","wǒ","zǒu","guò","hěn","duō","cì",""],"k":"이 길은 내가 여러 번 걸어 봤다."},{"z":["我","从来","没有","去","过","北京","。"],"p":["wǒ","cónglái","méiyǒu","qù","guò","Běijīng",""],"k":"나는 베이징에 가 본 적이 한 번도 없다."}],"q":[{"z":["我","吃","过","中国","菜","。"],"p":["wǒ","chī","guò","Zhōngguó","cài",""],"k":"나는 중국 음식을 먹어 본 적이 있다.","b":2,"o":["过","了","着"]}]},{"id":21,"lv":2,"t":"着: 상태의 지속","f":"동사 + 着","d":"동작이 끝난 뒤의 상태가 계속됨을 나타냅니다. ‘~해 있다, ~한 채로’.","ex":[{"z":["门","开","着","。"],"p":["mén","kāi","zhe",""],"k":"문이 열려 있다."},{"z":["他","笑","着","说","。"],"p":["tā","xiào","zhe","shuō",""],"k":"그는 웃으면서 말했다."}],"q":[{"z":["他","一直","在","门口","站","着","。"],"p":["tā","yīzhí","zài","ménkǒu","zhàn","zhe",""],"k":"그는 계속 문 앞에 서 있다.","b":5,"o":["着","过","了"]}]},{"id":22,"lv":2,"t":"正在…呢: 진행","f":"正在/在 + 동사 (+ 呢)","d":"‘~하고 있는 중이다’. 正在, 在, 문장 끝 呢 중 하나만 써도 됩니다.","ex":[{"z":["我","正在","学习","汉语","。"],"p":["wǒ","zhèngzài","xuéxí","Hànyǔ",""],"k":"나는 중국어를 공부하고 있다."},{"z":["妈妈","在","做饭","呢","。"],"p":["māma","zài","zuòfàn","ne",""],"k":"엄마는 밥을 하고 있다."}],"q":[{"z":["他","正在","准备","考试","。"],"p":["tā","zhèngzài","zhǔnbèi","kǎoshì",""],"k":"그는 시험을 준비하고 있다.","b":1,"o":["正在","已经","过"]}]},{"id":23,"lv":2,"t":"比: 비교","f":"A 比 B + 형용사 (+ 차이)","d":"‘A가 B보다 ~하다’. 很·非常은 쓸 수 없고, 