[{"id":1,"lv":1,"t":"是: A는 B이다","f":"A 是 B","d":"명사와 명사를 ‘~이다’로 잇습니다. 부정은 不是. 형용사 앞에는 쓰지 않습니다 (我很忙 O, 我是忙 X).","ex":[{"z":["我","是","学生","。"],"p":["wǒ","shì","xuésheng",""],"k":"나는 학생이다."},{"z":["他","不","是","老师","。"],"p":["tā","bú","shì","lǎoshī",""],"k":"그는 선생님이 아니다."}],"q":[{"z":["她","是","我","的","朋友","。"],"p":["tā","shì","wǒ","de","péngyou",""],"k":"그녀는 나의 친구이다.","b":1,"o":["是","在","有"]},{"z":["我","不","是","中国","人","。"],"p":["wǒ","bú","shì","Zhōngguó","rén",""],"k":"나는 중국 사람이 아니다.","b":1,"o":["不","没","别"]}]},{"id":2,"lv":1,"t":"吗: 예/아니오 의문문","f":"평서문 + 吗？","d":"평서문 끝에 吗를 붙이면 ‘~입니까?’가 됩니다. 의문사(什么·谁 등)가 있는 문장에는 吗를 붙이지 않습니다.","ex":[{"z":["你","是","学生","吗","？"],"p":["nǐ","shì","xuésheng","ma",""],"k":"너는 학생이야?"},{"z":["你","喜欢","喝","茶","吗","？"],"p":["nǐ","xǐhuan","hē","chá","ma",""],"k":"너 차 마시는 거 좋아해?"}],"q":[{"z":["你","认识","他","吗","？"],"p":["nǐ","rènshi","tā","ma",""],"k":"너 그 사람 알아?","b":3,"o":["吗","呢","吧"]},{"z":["这","是","你","的","书","吗","？"],"p":["zhè","shì","nǐ","de","shū","ma",""],"k":"이거 네 책이야?","b":5,"o":["吗","的","了"]}]},{"id":3,"lv":1,"t":"呢: ~는요?","f":"명사 + 呢？","d":"앞에서 한 질문을 되물을 때 ‘~는?’의 뜻입니다. 我很好，你呢？(나는 잘 지내, 너는?)","ex":[{"z":["我","很","好","，","你","呢","？"],"p":["wǒ","hěn","hǎo","","nǐ","ne",""],"k":"나는 잘 지내, 너는?"},{"z":["我","的","手机","呢","？"],"p":["wǒ","de","shǒujī","ne",""],"k":"내 휴대폰은?"}],"q":[{"z":["我","是","学生","，","你","呢","？"],"p":["wǒ","shì","xuésheng","","nǐ","ne",""],"k":"나는 학생이야, 너는?","b":5,"o":["呢","吗","吧"]}]},{"id":4,"lv":1,"t":"의문사 의문문","f":"什么 · 谁 · 哪儿 · 怎么","d":"묻고 싶은 자리에 의문사를 그대로 넣습니다. 어순이 바뀌지 않아요. 你叫什么名字？ 他是谁？ 你去哪儿？","ex":[{"z":["你","叫","什么","名字","？"],"p":["nǐ","jiào","shénme","míngzi",""],"k":"너는 이름이 뭐야?"},{"z":["他","是","谁","？"],"p":["tā","shì","shuí",""],"k":"그는 누구야?"},{"z":["你","去","哪儿","？"],"p":["nǐ","qù","nǎér",""],"k":"너 어디 가?"}],"q":[{"z":["你","想","吃","什么","？"],"p":["nǐ","xiǎng","chī","shénme",""],"k":"너 뭐 먹고 싶어?","b":3,"o":["什么","谁","哪儿"]},{"z":["你","家","在","哪儿","？"],"p":["nǐ","jiā","zài","nǎér",""],"k":"너희 집은 어디야?","b":3,"o":["哪儿","什么","谁"]}]},{"id":5,"lv":1,"t":"几 · 多少: 몇, 얼마","f":"几 + 양사 + 명사 / 多少","d":"10 이하로 예상되면 几(양사 필요), 큰 수나 모를 때는 多少(양사 생략 가능). 값을 물을 때는 多少钱.","ex":[{"z":["你","家","有","几","口","人","？"],"p":["nǐ","jiā","yǒu","jǐ","kǒu","rén",""],"k":"너희 집은 식구가 몇이야?"},{"z":["这","个","多少","钱","？"],"p":["zhè","ge","duōshǎo","qián",""],"k":"이거 얼마예요?"}],"q":[{"z":["现在","几","点","？"],"p":["xiànzài","jǐ","diǎn",""],"k":"지금 몇 시야?","b":1,"o":["几","多少","什么"]},{"z":["这","件","衣服","多少","钱","？"],"p":["zhè","jiàn","yīfu","duōshǎo","qián",""],"k":"이 옷 얼마예요?","b":3,"o":["多少","几","什么"]}]},{"id":6,"lv":1,"t":"양사","f":"수사 + 양사 + 명사","d":"수와 명사 사이에 양사가 꼭 들어갑니다. 가장 흔한 것은 个. 책은 本, 옷은 件, 잔은 杯.","ex":[{"z":["我","有","一","个","弟弟","。"],"p":["wǒ","yǒu","yí","gè","dìdi",""],"k":"나는 남동생이 한 명 있다."},{"z":["我","买","了","两","本","书","。"],"p":["wǒ","mǎi","le","liǎng","běn","shū",""],"k":"나는 책 두 권을 샀다."}],"q":[{"z":["我","想","喝","一","杯","水","。"],"p":["wǒ","xiǎng","hē","yì","bēi","shuǐ",""],"k":"나는 물 한 잔 마시고 싶다.","b":4,"o":["杯","本","件"]},{"z":["我","想","买","一","件","衣服","。"],"p":["wǒ","xiǎng","mǎi","yí","jiàn","yīfu",""],"k":"나는 옷을 한 벌 사고 싶다.","b":4,"o":["件","本","个"]}]},{"id":7,"lv":1,"t":"的: ~의","f":"명사/대명사 + 的 + 명사","d":"소유나 수식을 나타냅니다. 가족·소속 관계(我妈妈, 我们学校)에서는 보통 的를 뺍니다.","ex":[{"z":["这","是","我","的","书","。"],"p":["zhè","shì","wǒ","de","shū",""],"k":"이건 나의 책이다."},{"z":["她","是","我","的","朋友","。"],"p":["tā","shì","wǒ","de","péngyou",""],"k":"그녀는 나의 친구다."}],"q":[{"z":["这","是","老师","的","电脑","。"],"p":["zhè","shì","lǎoshī","de","diànnǎo",""],"k":"이건 선생님의 컴퓨터다.","b":3,"o":["的","得","地"]}]},{"id":8,"lv":1,"t":"有 · 没有","f":"A 有 B / A 没有 B","d":"‘가지고 있다, 있다’. 부정은 不有가 아니라 没有입니다.","ex":[{"z":["我","有","一","个","弟弟","。"],"p":["wǒ","yǒu","yí","gè","dìdi",""],"k":"나는 남동생이 한 명 있다."},{"z":["我","没有","时间","。"],"p":["wǒ","méiyǒu","shíjiān",""],"k":"나는 시간이 없다."}],"q":[{"z":["我","没有","钱","。"],"p":["wǒ","méiyǒu","qián",""],"k":"나는 돈이 없다.","b":1,"o":["没有","不有","不是"]}]},{"id":9,"lv":1,"t":"在: ~에 있다, ~에서","f":"在 + 장소 / 在 + 장소 + 동사","d":"동사로 쓰면 ‘~에 있다’, 동사 앞에 오면 ‘~에서’. 장소는 동사 앞에 둡니다 (我在学校学习 O, 我学习在学校 X).","ex":[{"z":["我","的","手机","在","桌子","上","。"],"p":["wǒ","de","shǒujī","zài","zhuōzi","shàng",""],"k":"내 휴대폰은 탁자 위에 있다."},{"z":["她","在","医院","工作","。"],"p":["tā","zài","yīyuàn","gōngzuò",""],"k":"그녀는 병원에서 일한다."}],"q":[{"z":["他","在","家","看","电视","。"],"p":["tā","zài","jiā","kàn","diànshì",""],"k":"그는 집에서 텔레비전을 본다.","b":1,"o":["在","是","有"]}]},{"id":10,"lv":1,"t":"了: 완료","f":"동사 + 了","d":"동작이 끝났음을 나타냅니다. 부정은 没(有) + 동사로 하고 了를 뺍니다 (我没吃 O, 我没吃了 X).","ex":[{"z":["我","吃","了","两","个","包子","。"],"p":["wǒ","chī","le","liǎng","gè","bāozi",""],"k":"나는 바오쯔 두 개를 먹었다."},{"z":["我","还","没","吃","。"],"p":["wǒ","hái","méi","chī",""],"k":"나는 아직 안 먹었다."}],"q":[{"z":["他","给","我","打","电话","了","。"],"p":["tā","gěi","wǒ","dǎ","diànhuà","le",""],"k":"그가 나에게 전화했다.","b":5,"o":["了","过","着"]},{"z":["我","昨天","没","去","。"],"p":["wǒ","zuótiān","méi","qù",""],"k":"나는 어제 안 갔다.","b":2,"o":["没","不","别"]}]},{"id":11,"lv":1,"t":"想 · 要","f":"想/要 + 동사","d":"想은 ‘~하고 싶다’(바람), 要는 ‘~하려고 하다, ~할 것이다’(의지·계획, 더 강함).","ex":[{"z":["我","想","喝","水","。"],"p":["wǒ","xiǎng","hē","shuǐ",""],"k":"나는 물을 마시고 싶다."},{"z":["我","明天","要","去","北京","。"],"p":["wǒ","míngtiān","yào","qù","Běijīng",""],"k":"나는 내일 베이징에 간다."}],"q":[{"z":["我","想","去","中国","。"],"p":["wǒ","xiǎng","qù","Zhōngguó",""],"k":"나는 중국에 가고 싶다.","b":1,"o":["想","会","在"]}]},{"id":12,"lv":1,"t":"会 · 能","f":"会/能 + 동사","d":"会는 배워서 ‘할 줄 안다’, 能은 조건·능력이 되어 ‘할 수 있다’.","ex":[{"z":["你","会","说","汉语","吗","？"],"p":["nǐ","huì","shuō","Hànyǔ","ma",""],"k":"너 중국어 할 줄 알아?"},{"z":["你","能","帮","我","吗","？"],"p":["nǐ","néng","bāng","wǒ","ma",""],"k":"나 좀 도와줄 수 있어?"}],"q":[{"z":["我","会","说","一点儿","汉语","。"],"p":["wǒ","huì","shuō","yìdiǎnér","Hànyǔ",""],"k":"나는 중국어를 조금 할 줄 안다.","b":1,"o":["会","想","在"]}]},{"id":13,"lv":1,"t":"也 · 都","f":"주어 + 也/都 + 동사","d":"也는 ‘~도’, 都는 ‘모두’. 둘 다 동사 앞, 주어 뒤에 옵니다. 같이 쓰면 也都.","ex":[{"z":["你","也","是","中国","人","吗","？"],"p":["nǐ","yě","shì","Zhōngguó","rén","ma",""],"k":"너도 중국 사람이야?"},{"z":["我","的","朋友","都","很","好","。"],"p":["wǒ","de","péngy